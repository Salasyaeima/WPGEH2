  m_Script: {fileID: 11500000, guid: 370cdd163eba56343ad0423ed929ef6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textUI: {fileID: 856360262}
  targetWalk: {fileID: 1820767001}
  textList:
  - text: Aduh kenapa kamar ini berantakan sekali sih?!
    triggerAngryModel: 0
  - text: Kemana Andy?!, kenapa kamarnya dibiarkan seperti ini!?!?
    triggerAngryModel: 0
  - text: Andy! ini hasilnya kalau kerjaannya cuma main HP! Kamarmu jadi jorok gitu!
    triggerAngryModel: 0
  - text: Iyaa, Bu. . . Maaf ya. Nanti aku bersihin kok.
    triggerAngryModel: 0
  - text: Kamu ini, nanti-nanti aja terus! Cepat beresin sana!
    triggerAngryModel: 0
  - text: Heh!!! Sini Hp Kamu!
    triggerAngryModel: 0
  - text: Ehh-! Ibu jangan lah
    triggerAngryModel: 0
  - text: Masa langsung dirampas sih bu
    triggerAngryModel: 0
  - text: Cepat bereskan kamarmu! ibu mau pergi dulu
    triggerAngryModel: 0
  - text: Kalau ibu masih lihat kamu baru mau bersihin, Awas Kamu!
    triggerAngryModel: 1
  - text: Ehh-! Iya Buu
    triggerAngryModel: 0
  - text: Jangan cuman kamar kamu saja tapi semuanya!
    triggerAngryModel: 0
  - text: Yaudah Ibu pergi dulu, Bye
    triggerAngryModel: 0
  useAutoDisplay: 1
  displayDuration: 3
